# Скопируйте в .env и заполните реальными значениями. .env в .gitignore.
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER_URI=http://localhost:8082/realms/RecipeManagementSystem

# true — только если приложение доступно по HTTPS (иначе cookie не отправится)
COOKIE_SECURE=false

KEYCLOAK_MANAGER_CLIENT_SECRET=change-me
KEYCLOAK_CUSTOMER_CLIENT_SECRET=change-me

CATALOGUE_DB_USERNAME=catalogue
CATALOGUE_DB_PASSWORD=change-me
CATALOGUE_DB_NAME=catalogue
CATALOGUE_DB_URL=jdbc:postgresql://localhost:5432/catalogue

CUSTOMER_DB_USERNAME=customer_app
CUSTOMER_DB_PASSWORD=change-me
CUSTOMER_DB_NAME=customer_app
CUSTOMER_DB_URL=jdbc:postgresql://localhost:5434/customer_app

CATALOGUE_URI=http://localhost:8081
CATALOGUE_AUDIENCE=catalogue-service
SPRINGDOC_ENABLED=true

# Ограничение частоты запросов к публичному каталогу (на IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# true — только если перед сервисом стоит доверенный прокси, перезаписывающий X-Forwarded-For
RATE_LIMIT_TRUST_FORWARDED=false
